# [AgentDesk] 国内镜像源 + 并发与超时配置
# ---------------------------------------------------------------------------
# 为什么把这个文件提交进仓库：
#   用户级 ~/.npmrc 可能被覆盖或缺失，赛题评审/队友换机器后容易踩坑。
#   项目级 .npmrc 优先级更高，能保证「clone 下来就能装」。
# ---------------------------------------------------------------------------
registry=https://registry.npmmirror.com

# ---- 关闭供应链锁文件校验（★ 国内环境必须关，否则 install 会跑 1.5 小时）----
# pnpm 12.x 默认启用 supply-chain policy check，会为 lockfile 里每个条目
# 逐个发起网络校验。实测 908 个条目耗时 1h28m 且最终失败：
#   ✗ Lockfile failed supply-chain policy check (908 entries in 1h 28m 52.7s)
#   → ERR_PNPM_META_FETCH_FAIL
#
# 对本项目（赛题 Demo，依赖均锁定版本、全部来自官方 registry）无实际收益，
# 只带来巨量延迟，故关闭。
#
# 备选：命令行加 --trust-lockfile 效果相同（见 `pnpm install --help`）。
# ⚠️ 如果未来引入非可信私有源，请重新评估此项。
trust-lockfile=true

# ---- 并发（★ 实测结论：不要开大，保持默认）----
# 实测教训（2026-09-20）：
#   本机 20 核，曾把 network-concurrency 提到 32，结果 pnpm 的元数据请求
#   出现 190~270 秒的极端延迟（日志 [WARN] Request took 193520ms）。
#   单独压测证明镜像站本身不限流（32 并发每个 0.6~0.8s 正常），
#   但 pnpm 内部调度在过高并发下会劣化 → 反而更慢。
#   结论：保持默认 16/5 最稳，不要为了"提速"往上调。
network-concurrency=16
child-concurrency=5

# ---- 超时与容错 ----
fetch-retries=5
fetch-retry-maxtimeout=120000
fetch-timeout=180000
